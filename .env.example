# Card Factory configuration.
# Fill in the values below, save the file and start the application.
# Changes are read again when the Status screen opens and before each
# generation; only APP_PORT waits for the next start.
# Never share this file: it contains your API keys.

# --- Text generation (required) ---

# Provider for card text: openai, anthropic or google
LLM_PROVIDER=

# Your API key for the provider above
LLM_API_KEY=

# Model name for the provider above.
# Examples: openai: gpt-5 | anthropic: claude-sonnet-5-5 | google: gemini-2.5-pro
LLM_MODEL=

# --- Art generation (optional) ---
# Art needs an image-capable provider: openai or google (anthropic has no image
# generation). Leave IMAGE_PROVIDER empty to use LLM_PROVIDER for art when it is
# openai or google. Set it to use a different provider for art, for example
# LLM_PROVIDER=anthropic for text and IMAGE_PROVIDER=openai for art.
# Uploading your own images as art needs none of these settings.

# Provider for art: openai or google (empty = use LLM_PROVIDER)
IMAGE_PROVIDER=

# API key for art. Required when IMAGE_PROVIDER differs from LLM_PROVIDER;
# leave empty to reuse LLM_API_KEY when it equals LLM_PROVIDER. Ignored when
# IMAGE_PROVIDER is empty: art then uses LLM_API_KEY.
IMAGE_API_KEY=

# Image model name, required for art generation. Ignored when IMAGE_PROVIDER
# is empty and LLM_PROVIDER cannot generate images (anthropic).
# Examples: openai: gpt-image-1 | google: imagen-4.0-generate-001
IMAGE_MODEL=

# --- Application ---

# Local port of the application. Change it only if another program already
# uses it. The application is reachable only from this computer.
# A change takes effect at the next start.
APP_PORT=47821