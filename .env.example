# Copy to .env and fill it in. Never commit .env.

# Choose your provider: openai, anthropic or google
LLM_PROVIDER=anthropic
# Set your API Key here
LLM_API_KEY=
# Model name, as the provider calls it (see the provider documentation) #todo: link documentations here, and enable default if able
LLM_MODEL=
# Port for the local server (it only listens on this computer)
APP_PORT=8000